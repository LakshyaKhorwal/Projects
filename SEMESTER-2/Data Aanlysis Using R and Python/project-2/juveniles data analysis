crime_raw <- read.csv("NCRB-2021_Table_19B.2.csv", check.names = FALSE)

crime <- crime_raw[1:19, ]

# Simple column names 
crime$city    <- crime[["City"]]
crime$total   <- crime[["Total Persons Arrested by age and Sex"]]
crime$male    <- crime[["Total - Male"]]
crime$female  <- crime[["Total - Female"]]
crime$juv     <- crime[["Juveniles Apprehended - Total"]]
crime$age1830 <- crime[["18 Years & Above - Below 30 Years - Total"]]
crime$age3045 <- crime[["30 Years & above - Below 45 Years - Total"]]
crime$age4560 <- crime[["45 Years & above - Below 60 Years - Total"]]
crime$age60   <- crime[["60 Years & Above - Total"]]

cat("Rows:", nrow(crime), "| Columns:", ncol(crime), "\n")
print(head(crime[, c("city", "total", "male", "female")]))


# SECTION A: BAR GRAPHS

# GRAPH 1: Total Arrests — City wise

ggplot(crime, aes(x = reorder(city, total), y = total)) +
  geom_bar(stat = "identity", fill = "green", width = 0.7) +
  coord_flip() +
  geom_text(aes(label = comma(total)), hjust = -0.1, size = 3) +
  scale_y_continuous(labels = comma, limits = c(0, 145000)) +
  labs(
    title    = "Graph 1: Total Arrests by City (NCRB 2021)",
    subtitle = "Delhi sabse zyada | Kozhikode sabse kam",
    x        = "City",
    y        = "Total Persons Arrested"
  ) +
  theme_minimal(base_size = 12) +
  theme(plot.title = element_text(face = "bold"))

ggsave("Graph1_Total_Arrests.png", width = 11, height = 7, dpi = 150)
cat("Saved: Graph1_Total_Arrests.png\n")



# GRAPH 2: Male vs Female — Grouped Bar

