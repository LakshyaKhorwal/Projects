# SECTION E: SCATTER PLOT + SIMPLE LINEAR REGRESSION

# GRAPH 8: Scatter Plot — 18-30 vs Total Arrests


ggplot(crime, aes(x = age1830, y = total)) +
  geom_point(color = "purple", size = 4, alpha = 0.85) +
  geom_text(aes(label = city), vjust = -0.8, size = 2.8, color = "grey30") +
  scale_x_continuous(labels = comma) +
  scale_y_continuous(labels = comma) +
  labs(
    title    = "Graph 8: Scatter Plot — 18-30 Age Group vs Total Arrests",
    subtitle = "Har dot ek city hai | Strong positive relationship dikh raha hai",
    x        = "18-30 Age Group Arrests",
    y        = "Total Persons Arrested"
  ) +
  theme_minimal(base_size = 12) +
  theme(plot.title = element_text(face = "bold"))

ggsave("Graph8_Scatter.png", width = 10, height = 7, dpi = 150)
cat("Saved: Graph8_Scatter.png\n")


# SIMPLE LINEAR REGRESSION MODEL
# Y = total arrests (jo predict karna hai)
# X = 18-30 age group arrests (jisse predict karna hai)
# Formula: Y = a + b*X

model <- lm(total ~ age1830, data = crime)
print(summary(model))

a  <- round(coef(model)[1], 2)
b  <- round(coef(model)[2], 4)
r2 <- round(summary(model)$r.squared, 3)
pv <- summary(model)$coefficients[2, 4]

cat("\n--- Model Results (Simple Language) ---\n")
cat("Intercept (a) =", a, "\n")
cat("  Matlab: Jab 18-30 arrests = 0 ho, estimated total =", round(a), "\n")
cat("Slope (b) =", b, "\n")
cat("  Matlab: 18-30 mein 1 arrest badhne par total mein", b, "ki increase\n")
cat("R-squared =", r2, "\n")
cat("  Matlab: Model", r2 * 100, "% variation explain karta hai\n")
cat("p-value =", format(pv, scientific = TRUE), "\n")
cat("  Matlab: Model statistically significant hai (p < 0.05)\n")


# GRAPH 9: Regression Line  Scatter Plot


ggplot(crime, aes(x = age1830, y = total)) +
  geom_point(color = "purple", size = 4, alpha = 0.85) +
  geom_smooth(method = "lm", color = "purple", se = TRUE, linewidth = 1.2) +
  geom_text(aes(label = city), vjust = -0.8, size = 2.8, color = "grey30") +
  scale_x_continuous(labels = comma) +
  scale_y_continuous(labels = comma) +
  labs(
    title    = "Graph 9: Simple Linear Regression — 18-30 Arrests vs Total",
    subtitle = paste0("Y = ", a, " + ", b, " x X  |  R² = ", r2,
                      "  |  Red line = best fit line"),
    x        = "18-30 Age Group Arrests (X)",
    y        = "Total Persons Arrested (Y)"
  ) +
  theme_minimal(base_size = 12) +
  theme(plot.title = element_text(face = "bold"))

ggsave("Graph9_Regression.png", width = 10, height = 7, dpi = 150)
cat("Saved: Graph9_Regression.png\n")


