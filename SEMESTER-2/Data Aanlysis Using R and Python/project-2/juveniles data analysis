# GRAPH 3: Stacked Bar — Age Group by City

age_long <- data.frame(
  city  = rep(crime$city, 5),
  count = c(crime$juv, crime$age1830, crime$age3045, crime$age4560, crime$age60),
  group = rep(c("Juveniles", "18-30 Yrs", "30-45 Yrs", "45-60 Yrs", "60+ Yrs"),
              each = 19)
)
age_long$group <- factor(age_long$group,
  levels = c("Juveniles", "18-30 Yrs", "30-45 Yrs", "45-60 Yrs", "60+ Yrs"))

ggplot(age_long, aes(x = reorder(city, -count), y = count, fill = group)) +
  geom_bar(stat = "identity", position = "stack") +
  coord_flip() +
  scale_fill_brewer(palette = "Set2") +
  scale_y_continuous(labels = comma) +
  labs(
    title    = "Graph 3: Age Group Breakdown by City (Stacked Bar)",
    subtitle = "18-30 age group sabse bada contributor hai",
    x        = "City",
    y        = "Number of Arrests",
    fill     = "Age Group"
  ) +
  theme_minimal(base_size = 12) +
  theme(plot.title = element_text(face = "bold"))

ggsave("Graph3_Stacked_Age.png", width = 11, height = 7, dpi = 150)
cat("Saved: Graph3_Stacked_Age.png\n")


# SECTION B: PIE CHART

age_total <- data.frame(
  group = c("Juveniles", "18-30 Yrs", "30-45 Yrs", "45-60 Yrs", "60+ Yrs"),
