gdf       <- rbind(male_df, female_df)

ggplot(gdf, aes(x = reorder(city, -count), y = count, fill = gender)) +
  geom_bar(stat = "identity", position = "dodge", width = 0.7) +
  coord_flip() +
  scale_fill_manual(values = c("Male" = "blue", "Female" = "red")) +
  scale_y_continuous(labels = comma) +
  labs(
    title    = "Graph 2: Male vs Female Arrests by City (2021)",
